 "chapters": [
  {
   "name": "第一章生活垃圾卫生填埋",
   "sections": [
    "一、场地整理",
    "三、压实粘土防渗层",
    "十二、导气石笼井",
    "十五、地下水监测井",
    "十六、渗滤液抽排井",
    "十、帷幕灌浆垂直防渗。",
    "一、场地整理按设计图示尺寸以面积计算。",
    "二、垃圾坝、压实黏土防渗层按设计图示尺寸以体积计算。",
    "四、导流层敷设均按设计图示尺寸以面积计算。",
    "五、高密度聚乙烯( HDPE)管道敷设按设计图示尺寸以长度计算。",
    "六、盲沟填筑按设计图示尺寸以体积计算。",
    "七、导气石笼井钻孔区分孔深,按设计深度乘以设计井径截面积以体积计算。",
    "八、浮力垫、走道板工程按设计规格数量以数量计算。",
    "九、渗滤液抽排井按设计图示尺寸以深度计算。",
    "十、气体迁移监测井按设计图示尺寸以深度计算。",
    "十一、氨吹脱塔安装区分填料高度及塔体直径,按设计图示数量以数量计算。",
    "二、垃圾坝",
    "四、高密度聚乙烯(HDPE)土工膜敷设",
    "五、钠基膨润土防水毯敷设",
    "六、土工合成材料敷设",
    "七、防渗膜保护层",
    "八、帷幕灌浆垂直防渗",
    "九、导流层",
    "十、高密度聚乙烯(HDPE)管道敷设",
    "十一、盲沟填筑",
    "十三、调节池浮盖",
    "十四、填埋气体处理系统",
    "十七、气体迁移监测井",
    "十八、封场覆盖",
    "十九、防飞散网",
    "二十、渗滤液处理设备安装"
   ]
  },
  {
   "name": "第二章生活垃圾焚烧",
   "sections": [
    "一、自动感应洗车装置安装",
    "三、垃圾卸料门及车辆感应器安装",
    "五、工程范围及未包括的工作内容。",
    "四、除渣装置按设备重量计算,包括除渣机、液压油缸、控制水箱、控制水阀等。",
    "十三、汽车衡安装根据工艺系统设计流程及设备出力,按照设计安装数量计算。",
    "二、垃圾破碎机安装",
    "四、垃圾抓斗桥式起重机安装",
    "五、生活垃圾焚烧炉安装",
    "六、烟气净化处理设备安装",
    "七、除臭装置设备安装",
    "八、计量设备安装"
   ]
  }
