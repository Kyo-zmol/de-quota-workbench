 "chapters": [
  {
   "name": "第一章施工测量与路面开微槽",
   "sections": [
    "一、本章内容包括施工测量、路面开微槽、挡土板等。",
    "三、路面开微槽项目适用于宽30mm以内,深350mm以内的开槽。",
    "一、通信管道工程和通信线路工程的施工测量工程量应按建筑物外路由长度计算。",
    "二、单盘光缆测试子目,在计算工程量时,应按光缆芯数乘以设计配盘光缆数量计算。",
    "一、施工测量",
    "二、挡土板"
   ]
  },
  {
   "name": "第二章通信管道",
   "sections": [
    "三、铺设水泥管道",
    "六、铺设镀锌钢管管道",
    "五、本章铺设管道定额适用于公称直径100mm以内的通信线缆保护管。",
    "八、本章在使用地下定向钻孔敷管相关项目内容时应注意:",
    "九、不同孔径最大可敷设的管孔数可参考下表。",
    "一、混凝土管道基础",
    "二、塑料管道基础",
    "四、铺设塑料管道(包括硬管、波纹管、栅格管、蜂窝管)",
    "五、敷设硅芯管道",
    "七、地下定向钻孔敷管",
    "八、管道填充水泥沙浆、混凝土包封",
    "九、砌筑人(手)孔",
    "十、管道防水及其他"
   ]
  },
  {
   "name": "第三章通信杆路",
   "sections": [
    "一、立杆",
    "二、安装拉线",
    "二、关于下列各项费用的规定:",
    "四、拉线坑所在地表有水或严重渗水,应由设计另计取排水等措施费用。",
    "五、有关说明:",
    "三、架设吊线"
   ]
  },
  {
   "name": "第四章敷设光(电)缆",
   "sections": [
    "三、管道光(电)缆",
    "四、引上光(电)缆",
    "二、本章中相关自承式光缆的布放,无特殊施工工艺。",
    "三、顶棚内敷设线路时,人工乘以系数1.10。",
    "四、线缆与配线设备的终接内容未在本章列出,此部分见其他相关章节。",
    "五、自承式架空光(电)缆定额中的材料应根据设计选用。",
    "七、若在已有墙壁吊线上敷设光缆,执行墙壁光缆定额,人工乘以系数0.5。",
    "八、敷设塑料子管管道为De12mm及以下的HDPE高密度聚乙烯管。",
    "一、架空光(电)缆",
    "二、埋式光缆",
    "五、墙壁光(电)缆",
    "六、建筑物内光(电)缆"
   ]
  },
  {
   "name": "第五章埋式光缆保护与防护",
   "sections": [
    "一、埋式光缆保护",
    "一、本章顶管分“人工顶管”和“机械顶管”两种施工方式。",
    "二、敷设排流线消耗量,不包括光缆沟的挖沟人工。",
    "三、对地绝缘检查及处理的工程量,应按直埋光缆的路由长度计算。",
    "二、埋式光缆防护"
   ]
  },
  {
   "name": "第六章安装分光、分线、配线设备",
   "sections": [
    "一、本章内容包括用户网络设备(光交接箱、光分路设备及用户终端设备)的安装。",
    "二、本章不包括以下工作内容,应执行其他章节有关定额或规定。",
    "一、安装光(电)缆交接箱",
    "二、安装配线箱",
    "三、安装光分路器",
    "四、安装缆线终端盒、过线盒"
   ]
  },
  {
   "name": "第七章光(电)缆接续与测试",
   "sections": [
    "一、本章光缆接续与成端适用于熔接法和机械法两种施工工艺。",
    "三、光缆接续:室外管道光缆接续由设计根据实际情况增列光缆接头托架。",
    "四、光缆成端接头如果采用光缆成端接头盒,设计应按一条成端光缆补列一只接头盒。",
    "一、光缆接续与测试",
    "二、电缆接续与测试"
   ]
  },
  {
   "name": "第八章通信设备安装",
   "sections": [
    "一、安装机架(柜)",
    "四、安装与调测有线接入网设备",
    "二、本章包括以下工作内容:",
    "三、接入网设备分为有源光网络设备、无源光网络设备以及混合光电接入方式。",
    "五、本章定额中综合架(柜)包括各专业的空架、龙门架、混合架、集装架等。",
    "八、布放设备电缆定额适用于在电缆桥架、槽道及机房内地槽中施工。",
    "十、安装测试传输设备接口盘项目调整系数:",
    "十一、移动通信设备工程",
    "二、安装与调测驻地网用户交换设备",
    "三、安装与调测局域网设备",
    "五、安装与调测移动通信设备",
    "六、布放通信设备线缆",
    "一、不放坡挖沟,开挖路面面积。",
    "二、放坡挖沟,开挖路面面积。",
    "三、开挖沟土(石)方体积。",
    "四、开挖人孔坑土(石)方体积。",
    "五、符号说明:"
   ]
  }
 ],
